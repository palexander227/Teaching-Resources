<!DOCTYPE html>
<html>
<head>

<title>GMAT Full Diagnostic</title>

<style>

body{
font-family:Arial;
margin:40px;
background:#f4f6f8;
}

#container{
background:white;
padding:30px;
border-radius:10px;
box-shadow:0 0 10px rgba(0,0,0,0.1);
}

h1{
text-align:center;
}

#timer{
font-size:20px;
font-weight:bold;
text-align:right;
margin-bottom:20px;
}

#progress{
height:12px;
background:#ddd;
border-radius:6px;
margin-bottom:25px;
}

#bar{
height:12px;
width:0%;
background:#1f4e79;
border-radius:6px;
}

.question{
font-size:18px;
margin-bottom:20px;
}

.answers label{
display:block;
margin:8px 0;
}

button{
margin-top:20px;
padding:10px 20px;
font-size:16px;
background:#1f4e79;
color:white;
border:none;
border-radius:6px;
}

#result{
font-size:22px;
font-weight:bold;
text-align:center;
margin-top:30px;
}

</style>

</head>

<body>

<div id="container">

<h1>GMAT Diagnostic Test</h1>

<div id="timer">45:00</div>

<div id="progress"><div id="bar"></div></div>

<div id="questionArea"></div>

<button onclick="nextQuestion()">Next</button>

<div id="result"></div>

</div>

<script>

const questions = [

{
q:"1. If 2x + 5 = 17, what is x?",
choices:["4","5","6","7","8"],
answer:2
},

{
q:"2. What is 3^4 * 3^2 / 3^3 ?",
choices:["3","9","27","81","243"],
answer:2
},

{
q:"3. Machine A completes a job in 4 hours and Machine B in 6 hours. Working together how long?",
choices:["2.4 hrs","3 hrs","4 hrs","5 hrs","6 hrs"],
answer:0
},

{
q:"4. A class ratio boys:girls is 2:3 with 25 students. Boys?",
choices:["8","10","12","15","18"],
answer:1
},

{
q:"5. Average of 4 numbers is 10. Fifth number 20. New average?",
choices:["10","11","12","13","14"],
answer:2
},

{
q:"6. If x > y which must be true?",
choices:["x²>y²","x³>y³","x−y>0","x/y>1","x²−y²>0"],
answer:2
},

{
q:"7. Probability of rolling a 6 on a die?",
choices:["1/3","1/4","1/5","1/6","1/8"],
answer:3
},

{
q:"8. A price rises from 40 to 50. Percent increase?",
choices:["10%","20%","25%","30%","40%"],
answer:2
},

{
q:"9. If n divisible by 6 and 15, what must be true?",
choices:["divisible by 9","divisible by 10","divisible by 30","divisible by 45","divisible by 60"],
answer:2
},

{
q:"10. Solve x + 3 = 2x − 5",
choices:["6","7","8","9","10"],
answer:2
},

{
q:"11. DATA SUFFICIENCY: Is x>0? (1) x²>0 (2) x³>0",
choices:["A","B","C","D","E"],
answer:1
},

{
q:"12. DATA SUFFICIENCY: Value of x? (1) x²=16 (2) x>0",
choices:["A","B","C","D","E"],
answer:2
},

{
q:"13. DATA SUFFICIENCY: Is n even? (1) n² even (2) n divisible by 4",
choices:["A","B","C","D","E"],
answer:3
},

{
q:"14. DATA SUFFICIENCY: Is x>y? (1) x−y>0 (2) y−x<0",
choices:["A","B","C","D","E"],
answer:3
},

{
q:"15. DATA SUFFICIENCY: Value of x? (1) 2x+3=11 (2) x+4=8",
choices:["A","B","C","D","E"],
answer:3
},

{
q:"16. If 5 workers finish a job in 10 days, how long for 10 workers?",
choices:["2","3","4","5","6"],
answer:3
},

{
q:"17. Sum of angles of triangle?",
choices:["90","120","180","270","360"],
answer:2
},

{
q:"18. If x²=49 what is x?",
choices:["7","-7","±7","14","0"],
answer:2
},

{
q:"19. Median of 3,5,9,12,15?",
choices:["5","7","9","10","12"],
answer:2
},

{
q:"20. If price falls 20% then rises 20%, net effect?",
choices:["same","+4%","-4%","+2%","-2%"],
answer:2
},

{
q:"21. CRITICAL REASONING: Which weakens argument most?",
choices:["A","B","C","D","E"],
answer:2
},

{
q:"22. CRITICAL REASONING: Which supports argument?",
choices:["A","B","C","D","E"],
answer:1
},

{
q:"23. If 2x=10 then x?",
choices:["2","3","4","5","6"],
answer:3
},

{
q:"24. 20% of 50?",
choices:["5","8","10","12","15"],
answer:2
},

{
q:"25. Square root of 81?",
choices:["7","8","9","10","11"],
answer:2
},

{
q:"26. If 4x=20 then x?",
choices:["4","5","6","7","8"],
answer:1
},

{
q:"27. Probability of heads on coin?",
choices:["1/3","1/2","2/3","1/4","3/4"],
answer:1
},

{
q:"28. 12²?",
choices:["124","134","144","154","164"],
answer:2
},

{
q:"29. 15% of 200?",
choices:["20","25","30","35","40"],
answer:2
},

{
q:"30. Solve 3x=21",
choices:["5","6","7","8","9"],
answer:2
}

];

let current=0;
let score=0;

function showQuestion(){

let q=questions[current];

let html="<div class='question'>"+q.q+"</div>";

html+="<div class='answers'>";

for(let i=0;i<q.choices.length;i++){

html+="<label><input type='radio' name='choice' value='"+i+"'> "+q.choices[i]+"</label>";

}

html+="</div>";

document.getElementById("questionArea").innerHTML=html;

let percent=(current/questions.length)*100;
document.getElementById("bar").style.width=percent+"%";

}

function nextQuestion(){

let radios=document.getElementsByName("choice");

for(let r of radios){

if(r.checked){

if(parseInt(r.value)===questions[current].answer){

score++;

}

}

}

current++;

if(current>=questions.length){

finish();

}else{

showQuestion();

}

}

function finish(){

document.getElementById("questionArea").innerHTML="";

document.querySelector("button").style.display="none";

document.getElementById("bar").style.width="100%";

document.getElementById("result").innerHTML="Score: "+score+" / 30";

}

showQuestion();

let time=2700;

setInterval(function(){

time--;

let m=Math.floor(time/60);
let s=time%60;

if(s<10)s="0"+s;

document.getElementById("timer").innerHTML=m+":"+s;

if(time<=0){

finish();

}

},1000);

</script>

</body>
</html>
